# ==========================================
# Faceless Automation - Environment Template
# ==========================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.

# --- Core LLM / Content Generation ---
# Google Gemini API key for Ideator and Scriptwriter agents (Rule 2, 4)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Visual Assets ---
# Pexels API key for downloading stock video assets
PEXELS_API_KEY=your_pexels_api_key_here

# --- Publishing: YouTube Data API ---
# Path to the OAuth client secrets JSON file downloaded from Google Cloud Console (Rule 3)
YOUTUBE_CLIENT_SECRET=config/client_secret.json

# --- Publishing: Instagram Graph API ---
# User access token with instagram_basic, instagram_content_publish permissions
IG_ACCESS_TOKEN=your_instagram_user_access_token_here
# Instagram Professional / Business Account ID linked to Facebook Page
IG_ACCOUNT_ID=your_instagram_account_id_here

# --- Phase 4 Public Hosting: Backblaze B2 (Rule 6: Instagram Reels requires a crawlable public URL) ---
# S3-compatible endpoint URL (e.g., https://s3.eu-central-003.backblazeb2.com)
B2_ENDPOINT_URL=https://s3.your-region.backblazeb2.com
# Backblaze B2 Application Key ID
B2_KEY_ID=your_b2_key_id_here
# Backblaze B2 Application Key
B2_APPLICATION_KEY=your_b2_application_key_here
# Backblaze B2 Bucket Name configured with public read access
B2_BUCKET_NAME=your_b2_bucket_name_here
