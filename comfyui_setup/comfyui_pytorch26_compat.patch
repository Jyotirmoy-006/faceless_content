# ComfyUI PyTorch 2.6 & Python 3.11 Compatibility Patch
#
# Root Cause:
# 1. ComfyUI upstream master branch imports comfy_kitchen in several core and extension modules:
#    - comfy/ldm/modules/attention.py
#    - comfy/model_prefetch.py
#    - comfy/text_encoders/llama.py
#    - comfy/ldm/joyimage/model.py
#    - comfy/ldm/lightricks/vae/na_diffusion_decoder.py
#    - comfy_extras/nodes_sparse_attention.py
# 2. comfy_kitchen (v0.2.34) uses PEP 585 type hints (e.g. list[int], Tensor | None)
#    inside @torch.library.custom_op decorators (e.g., conv3d.py), which PyTorch 2.6 schema
#    inference engine rejects during module import on Python 3.11 with:
#    'ValueError: infer_schema(func): Parameter stride has unsupported type list[int]'.
# 3. comfy_kitchen is an optional accelerator for FP8/FP4 operations on CUDA 13+ devices.
#    SD1.5 standard checkpoint inference (e.g., DreamShaper 8) does not require it.
# 4. In upstream attention.py, model_management was also missing from top-level imports
#    when optional attention backends failed, causing a NameError on model_management.force_upcast_attention_dtype().
#
# This patch:
# - Wraps comfy_kitchen in try/except import guards with graceful fallback to None.
# - Explicitly imports model_management from comfy.
# - Makes external attention backends (sageattention, flash_attn, xformers) fail-soft rather than crashing on startup.
# - Safeguards the flash_attention_decode_is_available check in llama.py when comfy_kitchen is None.
#
diff --git a/comfy/ldm/joyimage/model.py b/comfy/ldm/joyimage/model.py
index 9d6951e5..4bed4eab 100644
--- a/comfy/ldm/joyimage/model.py
+++ b/comfy/ldm/joyimage/model.py
@@ -2,7 +2,10 @@
 import math
 from typing import Optional, Tuple
 
-import comfy_kitchen
+try:
+    import comfy_kitchen
+except Exception:
+    comfy_kitchen = None
 import torch
 import torch.nn as nn
 
